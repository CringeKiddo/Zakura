#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// =============================================================================
// Zakura Core - 3D Null, Adevob Vector Smear & Edge Halo / Deep Glow Engine
// -----------------------------------------------------------------------------
// Pass 0: 3D Scene / Cube Rasterization (Euclidean 3D Matrix Projection)
// Pass 1: Optical Flow Velocity Field Generation & Anime Contour Detection
// Pass 2: Adevob Vector Smear (Contour Trail Pulling with Stepped Shutter)
// Pass 3: Edge Halo Aura (16-tap Spiral), Sapphire Edge Glow & 3D Particles
// Pass 4: HDR Master Composite & Tonemap to Output Buffer
// =============================================================================

layout(push_constant) uniform PushConstants {
    int passIndex;
    int targetWidth;
    int targetHeight;
    int bandY;
    int bandHeight;
    float shutterAngle;      // e.g. 180.0 to 720.0
    int smearSamples;        // e.g. 6 to 16 samples
    float blurIntensity;     // 0.0 to 2.0
    float timeSeconds;
    int edgeEffectMode;      // 0: None, 1: Edge Halo Aura, 2: Sapphire Edge Glow, 3: Halftone Dots, 4: Boundary Particles
    float edgeGlowStrength;  // Master Edge Glow Intensity
    int seed;
} pc;

// STORAGE BUFFERS (Matching C++ Vulkan Bindings 0..6)
layout(std430, binding = 0) readonly buffer InCurrBuffer {
    uint inCurrentPixels[];
};

layout(std430, binding = 1) readonly buffer InPrevBuffer {
    uint inPrevPixels[];
};

layout(std430, binding = 2) writeonly buffer OutBuffer {
    uint outPixels[];
};

layout(std430, binding = 3) readonly buffer UboBuffer {
    float uboData[];
};

layout(std430, binding = 4) buffer VelocityBuffer {
    vec2 velocityMap[];
};

layout(std430, binding = 5) buffer SceneBuffer {
    uint scenePixels[];
};

layout(std430, binding = 6) buffer ParticleFxBuffer {
    uint particlePixels[];
};

// =============================================================================
// COLOR CONVERSIONS & MATH HELPERS
// =============================================================================

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec4 unpackRGBA8(uint p) {
    float r = float(p & 0xFFu) / 255.0;
    float g = float((p >> 8u) & 0xFFu) / 255.0;
    float b = float((p >> 16u) & 0xFFu) / 255.0;
    float a = float((p >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

uint packRGBA8(vec4 c) {
    c = clamp(c, 0.0, 1.0);
    uint r = uint(round(c.r * 255.0));
    uint g = uint(round(c.g * 255.0));
    uint b = uint(round(c.b * 255.0));
    uint a = uint(round(c.a * 255.0));
    return (a << 24u) | (b << 16u) | (g << 8u) | r;
}

float srgbToLinear(float c) {
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

vec3 srgbToLinear(vec3 c) {
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}

float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

vec3 linearToSrgb(vec3 c) {
    return vec3(linearToSrgb(c.r), linearToSrgb(c.g), linearToSrgb(c.b));
}

vec3 saturateColor(vec3 c, float s) {
    float l = luma(c);
    return max(mix(vec3(l), c, s), vec3(0.0));
}

// Pseudo-random hash for particle dither & jitter
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Safe clamp boundary pixel fetching
vec4 sampleCurrent(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(pc.targetWidth - 1, pc.targetHeight - 1));
    return unpackRGBA8(inCurrentPixels[coord.y * pc.targetWidth + coord.x]);
}

vec4 samplePrev(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(pc.targetWidth - 1, pc.targetHeight - 1));
    return unpackRGBA8(inPrevPixels[coord.y * pc.targetWidth + coord.x]);
}

vec4 sampleScene(ivec2 coord) {
    coord = clamp(coord, ivec2(0), ivec2(pc.targetWidth - 1, pc.targetHeight - 1));
    return unpackRGBA8(scenePixels[coord.y * pc.targetWidth + coord.x]);
}

// Ambient color sampler (smooth 16-tap fixed pattern)
vec3 sampleAmbientColor(ivec2 coord, float radiusPx) {
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    const int TAPS = 16;
    for (int k = 0; k < TAPS; k++) {
        float fr = (float(k) + 0.5) / float(TAPS);
        float rr = sqrt(fr) * radiusPx;
        float ang = float(k) * 2.39996323; // Golden ratio angle
        ivec2 c0 = coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr));
        vec3 s = srgbToLinear(sampleScene(c0).rgb);
        float w = smoothstep(0.015, 0.12, luma(s)) + 0.03;
        acc += s * w;
        wsum += w;
    }
    return acc / max(wsum, 1e-4);
}

// =============================================================================
// PASS 0: 3D SCENE & 3D NULL CUBE RASTERIZATION
// =============================================================================

void executePass0(ivec2 pixelCoord) {
    int idx = pixelCoord.y * pc.targetWidth + pixelCoord.x;
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(pc.targetWidth, pc.targetHeight);

    // Read 3D Camera & 3D Null parameters from UBO
    float rotY = uboData[16]; // Y-axis rotation
    float rotX = uboData[17]; // X-axis tilt
    float camZ = uboData[18] != 0.0 ? uboData[18] : 2.0; // Depth distance

    // Centered NDC coordinate (-1 to 1) with correct aspect ratio
    vec2 ndc = (uv - 0.5) * 2.0;
    ndc.y *= float(pc.targetHeight) / float(pc.targetWidth);

    vec3 rayOrigin = vec3(0.0, 0.0, camZ);
    vec3 rayDir = normalize(vec3(ndc, -1.0));

    float cosY = cos(rotY);
    float sinY = sin(rotY);
    float cosX = cos(rotX);
    float sinX = sin(rotX);

    // Invert rotation matrix onto ray to project into Cube Local Space
    vec3 rDir;
    rDir.x = cosY * rayDir.x - sinY * rayDir.z;
    rDir.y = sinX * (sinY * rayDir.x + cosY * rayDir.z) + cosX * rayDir.y;
    rDir.z = cosX * (sinY * rayDir.x + cosY * rayDir.z) - sinX * rayDir.y;

    vec3 rOrig;
    rOrig.x = cosY * rayOrigin.x - sinY * rayOrigin.z;
    rOrig.y = sinX * (sinY * rayOrigin.x + cosY * rayOrigin.z) + cosX * rayOrigin.y;
    rOrig.z = cosX * (sinY * rayOrigin.x + cosY * rayOrigin.z) - sinX * rayOrigin.y;

    vec4 finalColor = vec4(0.0);

    // Plane intersection at local Z = 0
    if (abs(rDir.z) > 0.0001) {
        float t = -rOrig.z / rDir.z;
        if (t > 0.0) {
            vec3 hit = rOrig + rDir * t;
            // Bound inside quad face [-0.5, 0.5]
            if (abs(hit.x) <= 0.5 && abs(hit.y) <= 0.5) {
                vec2 faceUv = hit.xy + 0.5;
                // Native media orientation lock: upright mapping
                ivec2 srcCoord = ivec2(faceUv * vec2(pc.targetWidth, pc.targetHeight));
                finalColor = sampleCurrent(srcCoord);
            }
        }
    }

    // Direct sample fallback if camera is flat / off-card
    if (finalColor.a <= 0.01) {
        finalColor = sampleCurrent(pixelCoord);
    }

    scenePixels[idx] = packRGBA8(finalColor);
}

// =============================================================================
// PASS 1: OPTICAL FLOW VECTOR FIELD & EDGE DETECTION
// =============================================================================

void executePass1(ivec2 pixelCoord) {
    int idx = pixelCoord.y * pc.targetWidth + pixelCoord.x;

    // Global 3D Null velocity delta from speed ramp
    float vx = uboData[64];
    float vy = uboData[65];

    // Perceptual luma Sobel edge detector
    float c00 = luma(sampleScene(pixelCoord + ivec2(-1, -1)).rgb);
    float c10 = luma(sampleScene(pixelCoord + ivec2( 0, -1)).rgb);
    float c20 = luma(sampleScene(pixelCoord + ivec2( 1, -1)).rgb);
    float c01 = luma(sampleScene(pixelCoord + ivec2(-1,  0)).rgb);
    float c21 = luma(sampleScene(pixelCoord + ivec2( 1,  0)).rgb);
    float c02 = luma(sampleScene(pixelCoord + ivec2(-1,  1)).rgb);
    float c12 = luma(sampleScene(pixelCoord + ivec2( 0,  1)).rgb);
    float c22 = luma(sampleScene(pixelCoord + ivec2( 1,  1)).rgb);

    float gx = (c20 + 2.0 * c21 + c22) - (c00 + 2.0 * c01 + c02);
    float gy = (c02 + 2.0 * c12 + c22) - (c00 + 2.0 * c10 + c20);
    float edgeGrad = sqrt(gx * gx + gy * gy);

    vec2 vel = vec2(vx, vy);
    // Amplify motion vectors along sharp anime line art and silhouette edges
    if (edgeGrad > 0.07) {
        vel *= (1.0 + edgeGrad * 1.6);
    }

    velocityMap[idx] = vel;
}

// =============================================================================
// PASS 2: ADEVOB OPTICAL VECTOR SMEAR (Stepped Sub-Frame Contours)
// =============================================================================

void executePass2(ivec2 pixelCoord) {
    int idx = pixelCoord.y * pc.targetWidth + pixelCoord.x;
    vec2 vel = velocityMap[idx];
    float intensity = pc.blurIntensity;
    int samples = clamp(pc.smearSamples, 1, 16);

    vec4 baseColor = sampleScene(pixelCoord);
    if (intensity <= 0.01 || length(vel) < 0.1) {
        outPixels[idx] = packRGBA8(baseColor);
        return;
    }

    // Normalized shutter angle ratio (180 deg = 0.5, 360 deg = 1.0, 720 deg = 2.0)
    float shutterScale = pc.shutterAngle / 360.0;
    vec2 stepVector = vel * (intensity * shutterScale) / float(samples);

    vec4 accumColor = vec4(0.0);
    float totalWeight = 0.0;

    // Stepped accumulation pulling edges along velocity trajectory
    for (int s = 0; s < samples; ++s) {
        float t = float(s) / float(samples);
        vec2 samplePos = vec2(pixelCoord) - stepVector * float(s);
        ivec2 sCoord = ivec2(round(samplePos));

        vec4 sColor = sampleScene(sCoord);
        // Exponential shutter falloff
        float weight = exp(-t * 1.85);

        accumColor += sColor * weight;
        totalWeight += weight;
    }

    vec4 finalSmear = (totalWeight > 0.0) ? (accumColor / totalWeight) : baseColor;
    outPixels[idx] = packRGBA8(finalSmear);
}

// =============================================================================
// PASS 3: EDGE HALO AURA, SAPPHIRE EDGE GLOW & 3D PARTICLES
// (Directly incorporating your Edge Halo & Sapphire logic)
// =============================================================================

void executePass3(ivec2 pixelCoord) {
    int idx = pixelCoord.y * pc.targetWidth + pixelCoord.x;
    vec3 sceneCol = srgbToLinear(sampleScene(pixelCoord).rgb);
    vec4 fxColor = vec4(0.0);

    // Calculate edge magnitude
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(sampleScene(pixelCoord + ivec2(x, y)).rgb);
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    // MODE 1: EDGE HALO AURA (16-Tap Spiral Outward Spill from your shader)
    if (pc.edgeEffectMode == 1 && pc.edgeGlowStrength > 0.01) {
        float spread = mix(2.0, 8.0, clamp(pc.edgeGlowStrength * 0.5, 0.0, 1.0));
        float eAcc = 0.0;
        float eWt = 0.0;

        for (int hk = 0; hk < 16; hk++) {
            float hfr = (float(hk) + 0.5) / 16.0;
            float hr = sqrt(hfr) * spread;
            float ha = float(hk) * 2.39996323; // Golden angle
            ivec2 hoff = ivec2(round(vec2(cos(ha), sin(ha)) * hr));
            float hwgt = exp(-hfr * 1.4);

            float lumTap = luma(sampleScene(pixelCoord + hoff).rgb);
            eAcc += lumTap * hwgt;
            eWt += hwgt;
        }

        float eWide = eAcc / max(eWt, 1e-4);
        float eH = smoothstep(0.025, 0.50, eWide);
        eH = eH * eH * (3.0 - 2.0 * eH);

        vec3 amb = sampleAmbientColor(pixelCoord, 24.0);
        vec3 haloCol = saturateColor(amb * 1.4 + vec3(1.0, 0.35, 0.65) * 0.5, 1.35);

        // Halo spills outward, never obscuring the core line
        float sideGate = 1.0 - smoothstep(0.08, 0.40, lineEdge);
        vec3 auraRgb = haloCol * eH * sideGate * pc.edgeGlowStrength * 1.2;
        fxColor = vec4(auraRgb, clamp(eH * pc.edgeGlowStrength, 0.0, 1.0));
    }
    // MODE 2: SAPPHIRE EDGE GLOW (Crisp Edge Rays from your shader)
    else if (pc.edgeEffectMode == 2 && pc.edgeGlowStrength > 0.01) {
        int ss = 4;
        vec3 n0 = srgbToLinear(sampleScene(pixelCoord + ivec2( ss, 0)).rgb);
        vec3 n1 = srgbToLinear(sampleScene(pixelCoord + ivec2(-ss, 0)).rgb);
        vec3 n2 = srgbToLinear(sampleScene(pixelCoord + ivec2(0,  ss)).rgb);
        vec3 n3 = srgbToLinear(sampleScene(pixelCoord + ivec2(0, -ss)).rgb);

        vec3 lit = n0;
        if (luma(n1) > luma(lit)) lit = n1;
        if (luma(n2) > luma(lit)) lit = n2;
        if (luma(n3) > luma(lit)) lit = n3;

        float ll = max(luma(lit), 1e-4);
        vec3 hueL = saturateColor(clamp(lit / ll, vec3(0.05), vec3(4.0)), 1.45);
        hueL /= max(luma(hueL), 1e-4);

        float edgeMask = smoothstep(0.12, 0.45, lineEdge);
        vec3 edgeCol = hueL * (ll * 1.8 + 0.35) * pc.edgeGlowStrength;
        fxColor = vec4(edgeCol * edgeMask, edgeMask);
    }
    // MODE 3: HALFTONE BOUNDARY DOTS
    else if (pc.edgeEffectMode == 3) {
        vec2 dotCoord = mod(vec2(pixelCoord), 6.0) - 3.0;
        float dist = length(dotCoord);
        float lum = luma(sceneCol);
        if (dist < (lum * 2.8) && lum > 0.2) {
            fxColor = vec4(vec3(0.0), 0.35);
        }
    }

    // 3D FLOATING PARTICLES TABLE (From UBO data table 512..1023)
    for (int p = 0; p < 32; ++p) {
        int pOff = 512 + p * 8;
        vec3 pPos = vec3(uboData[pOff + 0], uboData[pOff + 1], uboData[pOff + 2]);
        float pSize = uboData[pOff + 3] > 0.0 ? uboData[pOff + 3] : 3.5;
        vec4 pCol = vec4(uboData[pOff + 4], uboData[pOff + 5], uboData[pOff + 6], 1.0);

        if (pPos.z > 0.1) {
            vec2 pScreen = (pPos.xy / pPos.z) * 0.5 + 0.5;
            vec2 pPixel = pScreen * vec2(pc.targetWidth, pc.targetHeight);

            float d = length(vec2(pixelCoord) - pPixel);
            if (d < pSize) {
                float glow = smoothstep(pSize, 0.0, d);
                fxColor = mix(fxColor, pCol, glow * 0.85);
            }
        }
    }

    particlePixels[idx] = packRGBA8(fxColor);
}

// =============================================================================
// PASS 4: MASTER COMPOSITE (Screen Blending & Filmic Shoulder)
// =============================================================================

void executePass4(ivec2 pixelCoord) {
    int idx = pixelCoord.y * pc.targetWidth + pixelCoord.x;

    vec4 smearedColor = unpackRGBA8(outPixels[idx]);
    vec4 fxColor = unpackRGBA8(particlePixels[idx]);

    vec3 baseLinear = srgbToLinear(smearedColor.rgb);
    vec3 fxLinear = fxColor.rgb;

    // Screen blend edge halos & particles over motion-smeared footage
    vec3 compRgb = baseLinear + fxLinear - (baseLinear * fxLinear);

    // Soft highlight knee shoulder (preserves bright anime colors without harsh clipping)
    float peak = max(compRgb.r, max(compRgb.g, compRgb.b));
    if (peak > 1.0) {
        compRgb *= (1.0 + (peak - 1.0) / (peak * 1.5)) / peak;
    }

    vec3 finalDisplay = linearToSrgb(clamp(compRgb, 0.0, 1.0));
    outPixels[idx] = packRGBA8(vec4(finalDisplay, smearedColor.a));
}

// =============================================================================
// MAIN DISPATCH ROUTER
// =============================================================================

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixelCoord = ivec2(localCoord.x, pc.bandY + localCoord.y);

    if (pixelCoord.x >= pc.targetWidth || pixelCoord.y >= (pc.bandY + pc.bandHeight)) {
        return;
    }

    switch (pc.passIndex) {
        case 0: executePass0(pixelCoord); break;
        case 1: executePass1(pixelCoord); break;
        case 2: executePass2(pixelCoord); break;
        case 3: executePass3(pixelCoord); break;
        case 4: executePass4(pixelCoord); break;
        default: break;
    }
}
